# 构建产物
build/
out/
*.jar

# 从游戏目录同步的第三方依赖（不入库）
lib/*.jar
lib/*.dll

# 本机配置
local.properties

# 运行期产物
logs/
trace/
runs/
*.log

# IDE
.idea/
.vscode/
*.iml

# Python（后期训练侧）
__pycache__/
*.pyc
.venv/

# WorkBuddy 工作区数据（不随仓库发布）
.workbuddy/

# Gradle
.gradle/

# Gradle wrapper 的 jar 必须入库（上面的 *.jar 会误伤）
!gradle/wrapper/gradle-wrapper.jar
